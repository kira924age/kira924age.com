---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb/Breadcrumb.astro";
---

<Layout title="About | kira924age.com" description="About kira924age, a web developer from Japan.">
  <div class="pageContainer">
    <Breadcrumb items={[{ label: "Home", to: "/" }, { label: "About" }]} />

    <section>
      <h1 class="pageTitle">About Me</h1>
      <p class="mutedText">
        I'm a web developer from Japan. I completed my Bachelor of Engineering
        at The University of Electro-Communications in March 2023.
      </p>
      <div class="socialLinksGroup">
        <h2 class="socialLinksTitle">Find me online</h2>
        <div class="socialLinks" aria-label="Social links">
          <a href="https://github.com/kira924age" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.05c-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.34-1.77-1.34-1.77-1.09-.75.08-.74.08-.74 1.2.09 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.6-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" />
            </svg>
          </a>
          <a href="https://x.com/kira924age" target="_blank" rel="noopener noreferrer" aria-label="X">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.36l7.24-8.28L2.8 2h6.4l4.42 5.84L18.9 2Zm-1.09 17.79h1.73L8.28 4.1H6.42L17.81 19.79Z" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section class="detailSection">
      <h2>What I do</h2>
      <p>I mainly work on frontend-focused web development.</p>
    </section>

    <section class="detailSection">
      <h2>Interests</h2>
      <p>
        Outside coding, I enjoy anime, manga, and music. This site also works
        as a personal archive of things I like and projects I have built.
      </p>
      <p>Explore my collections:</p>
      <ul class="interestLinks">
        <li><a href="/anime">Anime</a></li>
        <li><a href="/manga">Manga</a></li>
        <li><a href="/music">Music</a></li>
      </ul>
    </section>

    <section class="detailSection">
      <h2>Certifications</h2>
      <p class="detailMeta">
        I obtained the following certifications as a hobby through personal
        interest and self-study.
      </p>
      <ul class="certificationList">
        <li>ITパスポート試験</li>
        <li>情報セキュリティマネジメント試験</li>
        <li>基本情報技術者試験</li>
        <li>実用英語技能検定準2級</li>
        <li>ファイナンシャル・プランニング技能検定3級</li>
        <li>実用英語技能検定2級</li>
      </ul>
    </section>
  </div>
</Layout>
