---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb/Breadcrumb.astro";
import { FAVORITE_ANIME_LIST } from "@/constants/anime";
---

<Layout title="Anime | kira924age.com" description="kira924age's favorite anime.">
  <div class="pageContainer">
    <Breadcrumb items={[{ label: "Home", to: "/" }, { label: "Anime" }]} />
    <header class="contentHeader">
      <h1 class="pageTitle">My Favorite Anime</h1>
      <p class="pageSubtitle">
        Here are some of the anime series that I truly love.
      </p>
    </header>

    <div class="cardGrid">
      {FAVORITE_ANIME_LIST.map((anime) => (
        <article class="favoriteCard">
          <div class="cardContent">
            <h2 class="cardTitle">{anime.name}</h2>
            {anime.tags && <div class="tags">{anime.tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
