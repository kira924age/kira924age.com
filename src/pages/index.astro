---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb/Breadcrumb.astro";
---

<Layout>
  <div class="pageContainer">
    <Breadcrumb items={[{ label: "Home" }]} />

    <section class="homeIntro">
      <h1 class="heading">Hi there, I'm kira924age</h1>
      <p>
        Welcome! I'm a web developer who enjoys anime and manga. I earned my
        Bachelor of Engineering from The University of Electro-Communications
        in March 2023. Explore my site to discover more about my works and
        personal interests.
        <a href="/about" class="moreLink">More about me</a>
      </p>
    </section>

    <section>
      <h2 class="heading">My works</h2>
      <p class="pageSubtitle">
        I build web applications and interactive tools with a focus on useful,
        thoughtful user experiences.
        <a href="/works" class="moreLink">View my works</a>
      </p>
    </section>
  </div>
</Layout>
